# LegalX Backend — environment
#
# Copy to .env for local development. In production these are set in the
# Render dashboard (Environment → Environment Variables), never committed.

# ── Supabase ──────────────────────────────────────────────────────────────────
# The service role key bypasses RLS and must stay server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used for user sign-in and password-recovery OTP verification, which run as the
# public anon role rather than service_role.
SUPABASE_ANON_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Signs the CSRF secret cookie. Required in production — the server refuses to
# start without it.
COOKIE_SECRET=
# Shared secret for scheduled jobs (/api/jobs/*) and the internal leads routes.
ADMIN_SECRET=
# Comma-separated origins allowed by CORS, e.g.
# https://legalxonline.com,https://www.legalxonline.com
ALLOWED_ORIGINS=http://localhost:3000
# Requests per 15 minutes across the whole service. High on purpose: all traffic
# arrives via the Vercel rewrite, so every visitor shares one bucket.
GLOBAL_RATE_LIMIT=3000

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Settings → Webhooks. Without it the webhook returns
# 500 rather than trusting an unverifiable delivery.
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Receives admin alerts: new lawyer applications, summariser outages.
ADMIN_EMAIL=contact@legalxonline.com

# ── Video / voice calls (Agora) ───────────────────────────────────────────────
AGORA_APP_ID=
# Never expose this to the frontend — tokens are minted server-side only.
AGORA_APP_CERTIFICATE=
AGORA_WEBHOOK_SECRET=

# ── Knowledge Center summarisation ────────────────────────────────────────────
# Primary provider. Gemini's free tier allows ~1M tokens/minute against Groq's
# 8,000, which is the difference between summarising a long judgment in one call
# and not being able to at all.
GEMINI_API_KEY=
SHORTS_LLM_PROVIDER=gemini
SHORTS_GEMINI_MODEL=gemini-2.5-flash

# Fallback, used automatically if the primary rejects the key or exhausts quota.
# An alert email goes to ADMIN_EMAIL when that happens.
GROQ_API_KEY=
SHORTS_LLM_FALLBACK=groq
SHORTS_LLM_MODEL=openai/gpt-oss-120b

# Optional third provider.
OPENROUTER_API_KEY=

# Milliseconds between documents during ingest. Defaults to 1,500 for Gemini and
# 22,000 for Groq — set only to override.
# SHORTS_PACE_MS=

# Sent when fetching RSS feeds and articles. Several Indian government sites
# return 403 to any User-Agent that is not a browser; changing this is a
# deliberate decision, not a default.
# SHORTS_USER_AGENT=LegalXOnline/1.0 (+https://legalxonline.com)

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Render sets RENDER=true and RENDER_EXTERNAL_URL automatically.
# Used to build password-reset links when the request origin is untrusted.
PUBLIC_APP_URL=https://www.legalxonline.com
LOG_LEVEL=info
