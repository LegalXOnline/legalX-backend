# ── LegalX Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env — it is in .gitignore.

# Server
PORT=4000
NODE_ENV=development

# Supabase (from your Supabase project → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay (from Razorpay Dashboard → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Resend (from resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin secret — generate a random 32+ char string for admin routes
ADMIN_SECRET=generate-a-strong-random-secret-here

# CORS — comma-separated list of allowed frontend origins
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000
# Production (update when you deploy the frontend):
# ALLOWED_ORIGINS=https://legalxonline.com,https://legalxonline.netlify.app

# Render auto-injects this in production — used by the keep-alive cron
# RENDER_EXTERNAL_URL=https://legalx-backend.onrender.com
