# LegalX Backend — environment
#
# Copy to .env for local development. In production these are set in the
# Render dashboard (Environment → Environment Variables), never committed.
#
# Anything marked REQUIRED must be set or the service will not start, or will
# refuse the feature that needs it. Everything else has a working default.

# ── Supabase ──────────────────────────────────────────────────────────────────
# REQUIRED. The service role key bypasses RLS and must stay server-side only —
# client table access is revoked, so this is the only key that can read data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# REQUIRED. Used for sign-in and password-recovery OTP, which run as the public
# anon role rather than service_role.
SUPABASE_ANON_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production — signs the CSRF secret cookie. The server refuses to
# start without it.
COOKIE_SECRET=
# REQUIRED. Shared secret for the scheduled jobs (x-admin-secret header) and
# the internal leads endpoints (Authorization: Bearer). Thrown at startup if
# absent: a service that cannot authenticate its own cron should not boot.
ADMIN_SECRET=
# Comma-separated origins allowed by CORS. Wildcard preview domains are no
# longer trusted, so a Vercel preview you want to allow goes here by name.
ALLOWED_ORIGINS=http://localhost:3000
# Requests per 15 minutes across the whole service. High on purpose: all
# browser traffic arrives via the Vercel rewrite, so everyone shares one bucket.
GLOBAL_RATE_LIMIT=3000

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# REQUIRED to take payment. A key beginning rzp_test_ puts the UI into test
# mode automatically; nothing else needs changing to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED for the webhook. From Razorpay Dashboard → Settings → Webhooks.
# Without it the webhook answers 500 rather than trusting an unverifiable
# delivery — which means a client who pays and closes the tab before
# verification never has their payment recorded. Set this before taking money.
RAZORPAY_WEBHOOK_SECRET=
# Set to true to stop opening new pre-authorisations while leaving anyone with
# a balance able to consult. A switch for a bad afternoon, not a deploy.
# RAZORPAY_MAINTENANCE=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Receives admin alerts: new lawyer applications, summariser outages.
ADMIN_EMAIL=contact@legalxonline.com

# ── Video and voice (Agora) ───────────────────────────────────────────────────
AGORA_APP_ID=
# Never expose this to a client — tokens are minted server-side only.
AGORA_APP_CERTIFICATE=
AGORA_WEBHOOK_SECRET=

# ── Web push (VAPID) ──────────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Without these the browser bell still works; only push to a closed tab stops.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@legalxonline.com

# ── Knowledge Centre summarisation ────────────────────────────────────────────
# Primary provider. Gemini's free tier allows ~1M tokens/minute against Groq's
# 8,000, which is the difference between summarising a long judgment in one
# call and not being able to at all.
GEMINI_API_KEY=
SHORTS_LLM_PROVIDER=gemini
SHORTS_GEMINI_MODEL=gemini-2.5-flash

# Fallback, used automatically if the primary rejects the key or runs out of
# quota. An alert email goes to ADMIN_EMAIL when that happens.
GROQ_API_KEY=
SHORTS_LLM_FALLBACK=groq
SHORTS_LLM_MODEL=openai/gpt-oss-120b

# Optional third provider.
OPENROUTER_API_KEY=

# Ingest tuning. All optional — the defaults are tuned per provider.
# SHORTS_PACE_MS=            # ms between documents (1,500 Gemini / 22,000 Groq)
# SHORTS_GATE_MODEL=         # smaller model for the relevance gate
# SHORTS_COOLDOWN_MS=        # pause after a rate-limit response
# SHORTS_MAX_COOLDOWNS=      # give up after this many cooldowns in one run
# Sent when fetching RSS feeds. Several Indian government sites return 403 to
# any User-Agent that is not a browser, so changing this is deliberate.
# SHORTS_USER_AGENT=LegalXOnline/1.0 (+https://legalxonline.com)

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Used to build password-reset links when the request origin is untrusted.
PUBLIC_APP_URL=https://www.legalxonline.com
LOG_LEVEL=info
# RENDER and RENDER_EXTERNAL_URL are set by Render automatically. IS_PRODUCTION
# is an escape hatch for environments where neither is reliable.
# IS_PRODUCTION=false
